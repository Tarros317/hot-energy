# Public canonical origin (no trailing slash). Used for canonicals, OG, sitemap.
NEXT_PUBLIC_SITE_URL=https://hot-energy.com.ua

# Inbox that receives every form submission. Falls back to site.email.
CONTACT_TO=

# Optional SMTP relay for /api/zayavka. Without it the route falls back to the
# keyless browser relay (see src/lib/lead-direct.ts) and still delivers.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
