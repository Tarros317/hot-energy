# Public canonical origin (no trailing slash). Used for canonicals, OG, sitemap.
NEXT_PUBLIC_SITE_URL=https://hot-energy.com.ua

# Telegram group that receives every form submission.
#
# Both values are secrets and must be set as environment variables on the host
# (Netlify: Site configuration -> Environment variables), never committed. The
# token is what lets anyone post as the bot, so treat it like a password: if it
# leaks, revoke it with /revoke in @BotFather and paste the new one here.
#
# TELEGRAM_CHAT_ID is the group id, negative and starting with -100 for a
# supergroup. The bot has to be a member of that group to post into it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
